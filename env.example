# Строка подключения к PostgreSQL (хост — имя сервиса из docker-compose)
DATABASE_URL=postgresql://postgres:password@postgres_db:5432/my_service_db

# Внешний источник данных для получения задач
API_URL=https://api.example.com/tasks

# Внешний приёмник для отправки результата обработки
RESULT_URL=https://api.example.com/results

# Ключ OpenAI API (оставьте пустым для TEST_MODE или локальной разработки)
OPENAI_API_KEY=

# Модель OpenAI для классификации тональности
MODEL=gpt-4o-mini

# Системный промпт для определения тональности отзыва
PROMPT=Определи тональность отзыва. Ответь строго одним словом: positive, negative или neutral.

# Тестовый режим без реальных вызовов OpenAI
TEST_MODE=true

# Векторный поиск (Qdrant + Voyage AI embeddings)
VOYAGE_API_KEY=pa-DY6atRIHEneloIi4lvFd78MmKxjloQmY5AMRgbOKgBL
EMBED_MODEL=voyage-3.5-lite
EMBED_DIM=1024
CHAT_MODEL=gpt-4o-mini
CHUNK_SIZE=500
CHUNK_OVERLAP=75
TOP_K=5
QDRANT_URL=http://qdrant:6333
COLLECTION=docs
